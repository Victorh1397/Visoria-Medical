{
  "name": "visoria-landing",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "check": "astro check && tsc -p worker/tsconfig.json",
    "check:content": "node scripts/check-content.mjs",
    "test": "vitest run",
    "preview": "astro build && wrangler dev",
    "preview:form": "astro build --mode formtest && wrangler dev --var FORM_ENABLED:true --var DEMO_INBOX:inbox@example.com --var DEMO_FROM:demo@example.com --var TURNSTILE_SECRET:1x0000000000000000000000000000000AA",
    "deploy": "astro build && wrangler deploy",
    "astro": "astro"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "astro": "^7.4.13"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@cloudflare/vitest-plugin": "^1.8.5",
    "@cloudflare/workers-types": "^5.20261119.1",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1",
    "wrangler": "^4.165.0"
  }
}
