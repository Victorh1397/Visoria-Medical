---
// Página 404 propia (spec 001 R5). Cloudflare la sirve con estado 404 gracias a
// `not_found_handling: "404-page"` en wrangler.jsonc.
import Base from '@/layouts/Base.astro';
---

<Base title="Página no encontrada" noindex>
  <div class="container notfound">
    <p class="label">Error 404</p>
    <h1>Página no encontrada</h1>
    <p class="muted measure">La dirección que buscó no existe o cambió de lugar.</p>
    <p><a href="/">Volver al inicio</a></p>
  </div>
</Base>

<style>
  .notfound {
    display: grid;
    gap: var(--space-4);
    padding-block: var(--space-section);
  }
</style>
