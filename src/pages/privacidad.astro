---
import { getEntry, render } from 'astro:content';
import Legal from '@/layouts/Legal.astro';

const entry = await getEntry('legal', 'privacidad');
if (!entry) throw new Error('Falta src/content/legal/privacidad.md');
const { Content, headings } = await render(entry);
---

<Legal {...entry.data} headings={headings}>
  <Content />
</Legal>
