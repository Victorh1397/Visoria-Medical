---
// Destino de un envío sin JS que el Worker no pudo procesar (spec 004, ver Hallazgos).
import { getEntry } from 'astro:content';
import Base from '@/layouts/Base.astro';
import { site } from '@/config/site';

const entry = await getEntry('demo', 'demo');
if (!entry) throw new Error('Falta src/content/demo/demo.yaml');
const t = entry.data;
---

<Base title="No pudimos procesar su solicitud" noindex>
  <div class="container message">
    <p class="label">Demo</p>
    <h1>{t.errorTitle}</h1>
    <p class="muted measure">{t.errorText}</p>
    <p><a href="/demo">Volver al formulario</a></p>
    {site.contactEmail && <p class="muted">También puede escribirnos a <a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a>.</p>}
  </div>
</Base>

<style>
  .message {
    display: grid;
    gap: var(--space-4);
    padding-block: var(--space-section) 0;
  }
</style>
