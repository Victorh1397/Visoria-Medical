---
// Portada provisional con el design system (spec 002). El hero y las secciones reales llegan con la spec 003.
import Base from '@/layouts/Base.astro';
import Button from '@/components/Button.astro';
import { site } from '@/config/site';
---

<Base>
  <div class="container intro">
    <p class="label">Para consultorios y clínicas</p>
    <h1>{site.name}</h1>
    <p class="muted measure">Historias clínicas para consultorios y clínicas. Sitio en construcción.</p>
    <div class="intro__actions">
      <Button href={site.cta.href}>{site.cta.label}</Button>
    </div>
  </div>
</Base>

<style>
  .intro {
    display: grid;
    gap: var(--space-4);
    padding-block: var(--space-section);
  }

  .intro__actions {
    margin-top: var(--space-3);
  }
</style>
