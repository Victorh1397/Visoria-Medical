---
/**
 * Sección de la página: línea superior de 1 px, etiqueta numerada en mono ("01 · Funciones"),
 * título opcional y contenido. Sin fondos de color (constitution P2).
 */
interface Props {
  id?: string;
  index?: string;
  label?: string;
  title?: string;
}

const { id, index, label, title } = Astro.props;
const headingId = id ? `${id}-titulo` : undefined;
---

<section id={id} class="section" aria-labelledby={title ? headingId : undefined}>
  <div class="container">
    {
      (index || label || title) && (
        <header class="section__head">
          {(index || label) && (
            <p class="label">
              {index && <span class="section__index">{index}</span>}
              {label}
            </p>
          )}
          {title && <h2 id={headingId}>{title}</h2>}
        </header>
      )
    }
    <slot />
  </div>
</section>

<style>
  .section {
    padding-block: var(--space-section);
    border-top: var(--border);
  }

  .section__head {
    display: grid;
    gap: var(--space-3);
    margin-bottom: var(--space-7);
    max-width: var(--measure);
  }

  .section__index {
    color: var(--c-accent);
    margin-right: var(--space-3);
  }
</style>
