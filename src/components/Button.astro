---
/**
 * Botón: <a> si recibe href, <button> si no.
 * - primary: fondo de acento, el CTA "Solicitar demo". Uno por vista como máximo.
 * - secondary: borde fino y texto en tinta, para acciones de apoyo.
 */
import type { HTMLAttributes } from 'astro/types';

type Props = {
  href?: string;
  variant?: 'primary' | 'secondary';
  size?: 'md' | 'sm';
  type?: 'button' | 'submit';
} & Omit<HTMLAttributes<'a'> & HTMLAttributes<'button'>, 'type'>;

const { href, variant = 'primary', size = 'md', type = 'button', class: className, ...rest } = Astro.props;
const classes = ['btn', `btn--${variant}`, `btn--${size}`, className];
---

{
  href ? (
    <a href={href} class:list={classes} {...rest}>
      <slot />
    </a>
  ) : (
    <button type={type} class:list={classes} {...rest}>
      <slot />
    </button>
  )
}

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    min-height: 2.75rem;
    padding: 0 var(--space-5);
    border: 1px solid transparent;
    border-radius: var(--radius);
    font-family: var(--font-sans);
    font-size: var(--step-0);
    font-weight: 500;
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
    transition:
      background-color var(--dur) ease,
      border-color var(--dur) ease,
      color var(--dur) ease;
  }

  .btn--sm {
    min-height: 2.25rem;
    padding: 0 var(--space-4);
    font-size: var(--step--1);
  }

  .btn--primary {
    background: var(--c-accent);
    color: var(--c-on-accent);
  }

  .btn--primary:hover {
    background: var(--c-accent-hover);
    color: var(--c-on-accent);
  }

  .btn[aria-disabled='true'] {
    cursor: progress;
    opacity: 0.7;
  }

  .btn--secondary {
    background: transparent;
    border-color: var(--c-line-strong);
    color: var(--c-text);
  }

  .btn--secondary:hover {
    border-color: var(--c-text);
    color: var(--c-text);
  }
</style>
